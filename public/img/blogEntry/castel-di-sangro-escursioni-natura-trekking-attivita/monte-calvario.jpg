<style id="sccss">.mkdf-top-bar .mkdf-grid {
  height: 47px !important;
}
.mkdf-top-bar {
  background-color: rgba(28, 28, 28, 1);
  height: 47px !important;
}
.mkdf-top-bar {
  color: #fff;
  font-size: 15px;
  line-height: 1;
  padding-top: 1px !important;
}
.mkdf-tour-item-single-holder .mkdf-tour-tabs.mkdf-horizontal .mkdf-tabs-nav li a .mkdf-tour-nav-section-icon {
  display: inline-block;
  font-size: 18px;
  margin-right: 10px;
  line-height: 1em;
  font-weight: 400;
  color: #006887;
  top: 2px;
  position: relative;
}
.mkdf-tour-item-single-holder article .mkdf-tour-item-short-info .mkdf-destination-icon, .mkdf-tour-item-single-holder article .mkdf-tour-item-short-info .mkdf-tour-cat-item-icon, .mkdf-tour-item-single-holder article .mkdf-tour-item-short-info .mkdf-tour-info-icon {
  font-size: 14px;
  margin-right: 6px;
  vertical-align: top;
  display: inline-block;
  color: #006887;
}
.mkdf-tour-item-single-holder article .mkdf-tour-item-short-info .mkdf-tour-destination-holder a, .mkdf-tour-item-single-holder article .mkdf-tour-item-short-info .mkdf-tours-single-info-item a, .mkdf-tour-item-single-holder article .mkdf-tour-item-short-info .mkdf-tours-tour-categories-holder a, .mkdf-tour-item-single-holder article .mkdf-tour-item-short-info .mkdf-tours-tour-categories-item a {
  color: #000 !important;
}
.mkdf-tour-item-single-holder article .mkdf-tour-item-short-info .mkdf-tour-cat-item-text, .mkdf-tour-item-single-holder article .mkdf-tour-item-short-info .mkdf-tour-info-label {
  vertical-align: top;
  color: #000;
}
.mkdf-tour-item-single-holder article .mkdf-tour-item-short-info {
  line-height: 26px;
  font-size: 18px !important;
  color: #000 !important;
}
.mkdf-tour-item-single-holder article .mkdf-tour-main-info-holder li .mkdf-value {
  display: table-cell;
  vertical-align: middle;
  color: #000 !important;
}
.mkdf-tour-item-single-holder article .mkdf-reviews-list-info .mkdf-stars-wrapper {
  padding: 0;
  visibility: hidden;
}
.mkdf-tour-item-single-holder .mkdf-tour-item-section#tour-item-plan-id .mkdf-tour-item-plan-part-title {
  display: table-cell;
  vertical-align: middle;
  padding-left: 30px;
  font-weight: 700;
  color: #303030;
  font-size: 28px;
}
.mkdf-tour-item-single-holder .mkdf-tour-item-section .mkdf-tour-item-plan-part-description {
  padding-left: 90px;
  padding-bottom: 30px;
  font-size: 20px;
}
.mkdf-tour-item-single-holder .mkdf-tour-item-section#tour-item-location-id .mkdf-location-part .mkdf-location-addresses {
  margin: 0 0 0px;
  height: 0px !important;
}
.mkdf-title-holder .mkdf-title-wrapper .mkdf-page-subtitle {
  color: #ffffff;
  font-size: 39px;
  line-height: 32px !important;
}
.mkdf-tours-input-icon {
  position: absolute;
  left: 11px;
  top: 25px;
  width: auto;
  font-size: 18px;
  color: #006887 !important;
  z-index: 1;
  -webkit-transform: translateY(-50%);
  -moz-transform: translateY(-50%);
  transform: translateY(-50%);
}
.mkdf-search-ordering-holder .mkdf-search-ordering-list li.mkdf-search-ordering-item-active a .mkdf-search-ordering-title {
  color: #006887 !important;
}
.ion-arrow-up-a::before {
  color: #006887 !important;
}
.ion-calendar::before {
  color: #006887 !important;
}
.ion-arrow-down-a::before {
  color: #006887 !important;
}
.ion-edit::before {
  color: #006887 !important;
}
.mkdf-tours-list-item .mkdf-tours-list-item-bottom-content .mkdf-tour-info-icon {
  font-size: 14px;
  margin-right: 3px;
  color: #006887 !important;
  display: inline-block;
}
.mkdf-tours-list-item .mkdf-tours-list-item-bottom-content {
  line-height: 1;
  color: #000 !important;
  font-size: 15px;
}
.mkdf-tours-list-item .mkdf-tours-list-item-price .mkdf-tours-list-price-label {
  font-size: 15px;
  color: #000 !important;
}
.mkdf-content-aligment-center {
  text-align: center;
  font-size: 28px;
  color: #000 !important;
}
.mkdf-tours-standard-item .mkdf-tours-standard-item-price-holder .mkdf-tours-item-price-additional-text {
  font-weight: 400;
  color: #000 !important;
  font-size: 15px;
}
.mkdf-tours-standard-item .mkdf-tour-info-icon {
  font-size: 26px;
  margin: 0 3px 0 0;
  color: #006887;
}
.mkdf-tours-standard-item .mkdf-tours-standard-item-bottom-content {
  color: #006887;
  font-size: 24px;
}
.mkdf-owl-slider .owl-dots {
  text-align: center;
  margin: 0px 0 0;
}
.mkdf-owl-slider .owl-dots .owl-dot span {
  width: 16px;
  height: 16px;
  margin: 0 7px;
  border-radius: 50%;
  background-color: #fff;
  border: #fff;
  box-sizing: border-box;
  -webkit-transition: background-color 175ms cubic-bezier(.18,.43,.58,1),border 175ms cubic-bezier(.18,.43,.58,1);
  -moz-transition: background-color 175ms cubic-bezier(.18,.43,.58,1),border 175ms cubic-bezier(.18,.43,.58,1);
  transition: background-color 175ms cubic-bezier(.18,.43,.58,1),border 175ms cubic-bezier(.18,.43,.58,1);
}
#mkdf-back-to-top, .mkdf-owl-slider {
  visibility: hidden;
  background-color: rgba(255,255,255,0.4) !important;
  padding-bottom: 40px !important;
}
.mkdf-google-map-holder {
  position: relative;
  display: inline-block;
  width: 0% !important;
  vertical-align: middle;
  height: 0% !important;
}
.mkdf-tours-standard-item .mkdf-tours-standard-item-image-holder .mkdf-tours-standard-item-label-holder .mkdf-tour-item-label {
  width: 100%;
  bottom: 27px;
  left: 0px;
  display: block;
}
/*Modifiche Mirko */
.mkdf-tour-item-price-text{
		display:none
}
footer .widget ul li a{
		color:white;
}
.mkdf-tours-input-with-icon:nth-of-type(2),
.mkdf-tours-input-with-icon:nth-of-type(3) {
  display:none;
}
.wpb_widgetised_column .widget, aside.mkdf-sidebar .widget{
		margin-bottom:10px;
}
.mkdf-boxed-widget{
		display:none;
}

@media only screen and (max-width: 1024px) and (min-width: 768px) {
		.mkdf-tours-booking-form-holder {
				display:none;
		}
		.mkdf-sidebar{
				padding-left:20px
		}
}

.partner{
		border-radius:30px;
		padding:25px;
		gap:0px;
}
/*Personalizzazione numeri itinerario tour*/
.mkdf-tour-item-single-holder .mkdf-tour-item-section#tour-item-plan-id .mkdf-route-id{
		background-color: #086883;
		color:white;
		border-bottom-right-radius:20px;
}
.icon-activity{
		margin-bottom:40px
}
.mkdf-tour-item-single-holder .mkdf-tour-item-section#tour-item-plan-id .mkdf-tour-item-plan-part-title{
		line-height:normal;
		font-size:25px;
}
.mkdf-tour-item-single-holder .mkdf-tour-item-section .mkdf-tour-item-plan-part-description{
		font-size:17px;
}
.mkdf-tour-item-single-holder .mkdf-tour-item-section#tour-item-plan-id{
		margin-bottom:40px;
}

.entry-title{
background: rgba(0, 0, 0, 0.27);
border-radius: 16px 16px 0 0;
padding:20px !important;
}
.mkdf-post-title{
		padding:0px !important;
		background:none;
}
.mkdf-reviews-number-wrapper{
		display:none;
}
/*rimozione parti del template tour*/
.mkdf-tour-item-single-holder article .mkdf-info-section-part.mkdf-tour-item-main-info{
		display:none;
}
.mkdf-tour-item-single-holder .mkdf-tour-gallery-item-holder .mkdf-gallery-title{
		display:none;
}
.mkdf-tour-item-single-holder .mkdf-tour-item-section#tour-item-location-id .mkdf-location-part .mkdf-tour-location{
		display:none;
}
/*Testi footer centrali */
@media (max-width: 680px) {
		.mkdf-page-footer .mkdf-footer-top-holder .mkdf-footer-top-alignment-left{
				text-align:center;
		}
}
/*rimuovi info abbreviate tour */
.mkdf-tour-item-single-holder article .mkdf-tour-item-short-info{
    display:none !important;
}
@media (max-width: 768px) {
#tour-item-info-id {
	    padding: 20px 0px 20px 0 !important;
	}
	.mkdf-tour-item-single-holder article .mkdf-tour-item-title-holder .mkdf-tour-item-title{
		margin: 0 0 0 0 !important	
	}
	.mkdf-tour-item-single-holder .mkdf-tour-tabs.mkdf-horizontal{
		margin: 40px 0 20px 0;
	}
}
@media (min-width: 769px) {
#tour-item-info-id {
	    padding: 40px 0px 40px 0 !important;
	}}
/*Immagini titolo tour*/
@media (max-width: 440px) {
.mkdf-title-holder .mkdf-title-image img{
	object-fit:cover;
	height:35vh;
	}}
@media (max-width: 1024px) {
.mkdf-title-holder .mkdf-title-image img{
	object-fit:cover;
	height:60vh;
	}}
.mkdf-title-holder{
	background-size:cover;
	display: flex;
	margin: 0 auto 0 auto;
	max-width: 1600px;
	height: 650px !important;
}
.partner{
		padding:5px;
}</style><noscript><style> .wpb_animate_when_almost_visible { opacity: 1; }</style></noscript></head>
