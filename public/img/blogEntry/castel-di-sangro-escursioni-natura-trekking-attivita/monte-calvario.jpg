            .sfm-sticky-footer {
                display: none;
                position: fixed;
                bottom: 0;
                left: 0;
                right: 0;
                z-index: 9999;
            }
            
            @media (max-width: 1024px) {
                .sfm-sticky-footer {
                    display: block;
                }
                
                body {
                    padding-bottom: 80px;
                }
            }
            
            .sfm-buttons {
                display: flex;
                justify-content: space-around;
                align-items: center;
                gap: 5px;
                padding: 0 5px;
            }
            
            .sfm-button {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 4px;
                text-decoration: none;
                color: inherit;
                padding: 8px 4px;
                flex: 1;
                min-width: 0;
                transition: transform 0.2s ease, opacity 0.2s ease;
                -webkit-tap-highlight-color: transparent;
                background: none;
                border: none;
                cursor: pointer;
                font-family: inherit;
            }
            
            .sfm-button:active {
                transform: scale(0.95);
                opacity: 0.7;
            }
            
            .sfm-icon {
                line-height: 1;
                display: block;
            }
            
            .sfm-label {
                font-weight: 500;
                text-align: center;
                line-height: 1.2;
                display: block;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                width: 100%;
                max-width: 80px;
            }
        

